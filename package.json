{
  "name": "ssv-keys",
  "version": "1.3.0",
  "description": "Tool for splitting a validator key into a predefined threshold of shares via Shamir-Secret-Sharing (SSS), and encrypt them with a set of operator keys.",
  "author": "SSV.Labs",
  "repository": "https://github.com/ssvlabs/ssv-keys",
  "license": "GNU General Public License v3.0",
  "keywords": [
    "ssv",
    "ssv.labs",
    "keystore",
    "shares"
  ],
  "type": "module",
  "bin": {
    "ssv-keys": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:cli": "ts-node src/cli.ts",
    "dev:icli": "ts-node src/cli-interactive.ts",
    "icli": "node ./dist/tsc/src/cli-interactive.js",
    "cli": "node ./dist/tsc/src/cli.js",
    "lint": "eslint src/ --ext .js,.jsx,.ts,.tsx",
    "test": "jest",
    "clean": "rm -rf dist build package",
    "ts-node": "ts-node",
    "docs": "typedoc",
    "build": "vite build",
    "build-all": "pnpm run clean && pnpm run build",
    "pre-commit": "pnpm run lint && pnpm run build-all",
    "package-all": "ts-node build-binaries.ts"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@types/argparse": "^2.0.17",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.10",
    "@types/prompts": "^2.4.9",
    "husky": "^9.1.7",
    "jest": "^30.0.3",
    "jest-environment-jsdom": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jest-environment-uint8array": "^1.0.0",
    "jest-watch-typeahead": "3.0.1",
    "jsdom": "^26.1.0",
    "jsdom-global": "^3.0.2",
    "pkg": "^5.8.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.7",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@ssv-labs/ssv-sdk": "https://github.com/ssvlabs/ssv-sdk.git#ssv-keys-migration-1",
    "@types/figlet": "^1.7.0",
    "@types/node-forge": "^1.3.11",
    "argparse": "^2.0.1",
    "assert": "^2.1.0",
    "colors": "^1.4.0",
    "eth2-keystore-js": "^1.0.8",
    "events": "^3.3.0",
    "figlet": "^1.8.1",
    "moment": "^2.30.1",
    "node-forge": "^1.3.1",
    "prompts": "https://github.com/ssvlabs/prompts.git",
    "tslib": "^2.8.1"
  }
}
