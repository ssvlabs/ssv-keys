{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Interactive CLI",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/tsx/dist/cli.mjs",
      "args": [
        "${workspaceFolder}/src/cli-interactive.ts",
        "--operator-,,,",
        "--operator-ids=1,2,3,4",
        "--owner-address=0x012f55B6Cc5D57F943F1E79cF00214B652513f88",
        "--owner-nonce=0"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "Debug Interactive CLI (No Args)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/tsx/dist/cli.mjs",
      "args": ["${workspaceFolder}/src/cli-interactive.ts"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "NODE_ENV": "development"
      }
    }
  ],
  "inputs": [
    {
      "id": "cliArgs",
      "type": "promptString",
      "description": "Enter CLI arguments (optional)",
      "default": ""
    }
  ]
}
